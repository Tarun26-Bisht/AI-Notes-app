rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 150
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    // Note Validation
    function isValidNote(data) {
      return data.keys().hasAll(['userId', 'title', 'sourceType'])
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.sourceType is string && data.sourceType in ['text', 'pdf', 'audio', 'handwritten']
        && (!('originalFileName' in data) || (data.originalFileName is string && data.originalFileName.size() <= 255))
        && (!('rawContent' in data) || (data.rawContent is string && data.rawContent.size() <= 100000))
        && (!('executiveSummary' in data) || (data.executiveSummary is string && data.executiveSummary.size() <= 100000))
        && (!('estimatedReadTime' in data) || (data.estimatedReadTime is string && data.estimatedReadTime.size() <= 50))
        && (!('sentiment' in data) || (data.sentiment is string && data.sentiment in ['positive', 'neutral', 'urgent']))
        && (!('isArchived' in data) || (data.isArchived is bool))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 50))
        && (!('actionItems' in data) || (data.actionItems is list && data.actionItems.size() <= 100));
    }

    // Match /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user listing forbidden for PII privacy

      allow create: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming());

      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);

      allow delete: if false; // Prevent accidental account deletion

      // User notes subcollection: /users/{userId}/notes/{noteId}
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(noteId)
          && isValidNote(incoming())
          && incoming().userId == userId;

        allow update: if isOwner(userId) && isValidId(noteId)
          && isValidNote(incoming())
          && incoming().userId == existing().userId
          && incoming().userId == userId;

        allow delete: if isOwner(userId) && isValidId(noteId);
      }
    }
  }
}
